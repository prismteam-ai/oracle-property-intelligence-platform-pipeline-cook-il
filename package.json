{
  "name": "oracle-cook-il",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pipeline": "node apps/pipeline/dist/cli.js",
    "web": "node apps/web/dist/server/apps/web/src/main.js",
    "invoke-agent": "pnpm --filter @cook/agent-handler exec tsx ../../scripts/invoke-agent.ts"
  },
  "devDependencies": {
    "@cook/ipfs-publish": "workspace:*",
    "@duckdb/node-api": "1.4.5-r.1",
    "@eslint/js": "10.0.1",
    "@types/ngeohash": "0.6.8",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "ngeohash": "0.6.4",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "type": "module"
}
