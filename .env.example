# Socrata app token credentials (HTTP basic auth on every request)
SOCRATA_KEY_ID=your-socrata-key-id
SOCRATA_KEY_SECRET=your-socrata-key-secret
# IPFS publication (used by the publish step / web app)
PINATA_JWT=your-pinata-jwt
FILEBASE_ACCESS_KEY=your-filebase-access-key
FILEBASE_SECRET_KEY=your-filebase-secret-key
FILEBASE_BUCKET=your-filebase-bucket
# Agent / MCP
OPENAI_API_KEY=sk-your-openai-key
MCP_HTTP_AUTH_TOKEN=change-me
# Optional
# Pipeline: POST a JSON run summary ({run_id, status, counts, dead_letters, errors}) here when a run fails or has dead letters
ALERT_WEBHOOK_URL=
PORT=8080
DATA_DIR=data
# Web app optional overrides (default under DATA_DIR): DATASET_DB, DATASET_DIR, PUBLICATIONS_DIR, GIT_COMMIT
